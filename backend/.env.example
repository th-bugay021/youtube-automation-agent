NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://ytauto:ytauto_secret@localhost:5432/ytauto?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-64-char-hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-64-char-hex
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (Google / YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev: http://localhost:4000/api/auth/google/callback
# Production: https://youtube-automation-agent-e7hf.onrender.com/api/auth/google/callback
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Encryption (32 bytes hex, used to encrypt OAuth refresh tokens at rest)
TOKEN_ENCRYPTION_KEY=

# LLM (OpenAI-compatible API: works with OpenAI, Groq, Together, etc.)
# - For OpenAI: leave OPENAI_BASE_URL empty, set OPENAI_MODEL=gpt-4o-mini
# - For Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1, OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# CSRF
CSRF_SECRET=replace-with-random-string

# Cookies
# Leave COOKIE_DOMAIN empty for localhost, Render, Railway, Vercel, and most single-backend hosts.
# Use it only for a shared parent domain you control, e.g. .example.com.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Production cross-site frontend/backend deployments should use COOKIE_SECURE=true
# and COOKIE_SAME_SITE=none. If unset, the API infers safe defaults from NODE_ENV
# and FRONTEND_ORIGIN/GOOGLE_REDIRECT_URI.
COOKIE_SAME_SITE=

# === AI Video Creation Studio ===
# Supabase Storage (use the same project as DATABASE_URL).
# Service role key bypasses RLS — keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=studio

# Pixabay (free image API, https://pixabay.com/api/docs/)
PIXABAY_KEY=

# Text-to-speech: gTTS (Google Translate TTS) — free, no API key required.
# Optional: BCP-47 language code for the voiceover (default "en").
TTS_LANG=en
# Optional rate-limit tuning for per-scene gTTS calls (defaults shown).
TTS_RETRY_ATTEMPTS=3
TTS_RETRY_DELAY_MS=1500
TTS_SCENE_DELAY_MS=600

# Shotstack (cloud video rendering — replaces local FFmpeg to avoid OOM)
# Key must match the environment: stage (free, default) or v1 (production).
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
# Optional — max time to poll for a render before failing (ms). Default 600000 (10m).
SHOTSTACK_TIMEOUT_MS=
